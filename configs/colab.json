  "dataset": {
    "name": "sid_set",
    "labels": ["authentic", "ai_generated"],
    "excluded_labels": ["tampered", "mixed", "ai_edited", "ambiguous"],
    "manifest_version": 1,
    "raw_relative_path": "raw/sid_set",
    "labels_filename": "labels.csv",
    "images_directory": "images",
    "expected_raw_csv_rows": 20000,
    "perceptual_hash_max_distance": 4,
    "c2pa_scan_required_before_derivation": true,
    "split_fractions": {
      "seed_train": 0.6,
      "self_train_pool": 0.25,
      "selection_val": 0.075,
      "final_test": 0.075
    }
  },
  "task8b": {
    "enabled": false,
    "assumed_use": "noncommercial_research_hackathon",
    "allow_noncommercial_genimage": true,
    "source_relative_path": "raw/task8b",
    "inventory_filename": "sources.csv",
    "premier_relative_path": "raw/task8b/premier",
    "genimage_ai_relative_path": "raw/task8b/genimage_ai",
    "artifact_relative_path": "task8b",
    "supported_source_extensions": [".jpg", ".jpeg", ".png", ".tif", ".tiff"],
    "minimum_images_per_device": 10,
    "readiness": {
      "minimum_rows_per_label": 500,
      "minimum_authentic_devices": 10,
      "minimum_generator_families": 4,
      "minimum_prnu_training_devices": 5,
      "max_label_count_ratio": 1.25,
      "max_nuisance_balanced_accuracy": 0.65,
      "minimum_ca_metadata_fraction": 0.5,
      "minimum_ca_edge_rich_fraction": 0.25
    },
    "split_fractions": {
      "seed_train": 0.75,
      "selection_val": 0.125,
      "heldout_test": 0.125
    }
  },
  "model": {
    "identifier": "openai/clip-vit-large-patch14-336",
    "revision": "main",
    "input_size": 336,
    "rine_layers": [6, 12, 18, 24],
    "rine_representation_version": "rine-cls-v1",
    "freeze_backbone": true,
    "output": "p_ai_generated"
  },
  "preprocessing": {
    "version": "clip-image-processor-336-v1",
    "input_policy": "crop",
    "train_crop_size": 336,
    "validation_crop_size": 336,
    "small_image_policy": "pad_then_crop",
    "matched_clean": {
      "enabled": true,
      "candidate_quality_policies": ["fixed_q96", "uniform_q95_q100"],
      "label_independent": true
    }
  },
  "transform_engine": {
    "version": "task3-v1",
    "preprocessing_version": "clip-crop-v1",
    "resize_library": "Pillow",
    "resize_interpolation": "bilinear",
    "resize_filtering": "pillow_bilinear_fixed",
    "dimension_rounding": "floor(d * scale + 0.5)",
    "jpeg_storage": "JPEG",
    "non_jpeg_storage": "PNG",
    "padding": "symmetric_zero"
  },
  "training_policy": {
    "controlled": {
      "enabled": true,
      "clean_fraction": 0.5,
      "transformed_fraction": 0.5,
      "balance_labels": true,
      "uniform_transform_cells": true
    },
    "safe": {
      "enabled": false,
      "horizontal_flip_probability": 0.5,
      "color_jitter_fraction": 0.5,
      "rotation_degrees": 180,
      "mask_patch_size": 16,
      "mask_max_fraction": 0.75,
      "mask_probability": 0.5
    }
  },
  "benchmark_transforms": {
    "allow_chaining": false,
    "jpeg_quality": [90, 70, 50, 30],
    "gaussian_blur_sigma": [0.5, 1.0, 2.0],
    "resize_scale": [0.5, 0.25],
    "gaussian_noise_sigma": [0.02, 0.05, 0.1],
    "color_jitter_fraction": 0.2,
    "center_crop_fraction": 0.8
  },
  "features": {
    "rine": false,
    "frequency": false,
    "texture": false,
    "prnu_coherence": false,
    "rgb_correlation": false,
    "lab_correlation": false,
    "chromatic_aberration": false,
    "radial_distortion": false,
    "prnu_v2_runtime": false,
    "frequency_fast_track": false
  },
  "frequency": {
    "extractor_version": "frequency-v1",
    "radial_bins": 24,
    "angular_bins": 12,
    "dct_bins": 16,
    "phase_bins": 12,
    "max_analysis_size": 1024,
    "workers": 4
  },
  "auxiliary": {
    "extractor_version": "auxiliary-v1",
    "color_window_size": 64,
    "low_variance_epsilon": 0.0001,
    "prnu_block_size": 64,
    "prnu_denoise_sigma": 1.0,
    "prnu_min_dimension": 128,
    "optics_min_dimension": 256,
    "ca_scale_limit": 0.006,
    "ca_scale_steps": 13,
    "ca_min_edge_fraction": 0.02,
    "max_analysis_size": 1024,
    "optics_max_analysis_size": 512,
    "max_eligibility_rate_gap": 0.05,
    "workers": 4
  },
  "prnu_v2_runtime": {
    "extractor_version": "prnu-v2-runtime-v1",
    "crop_size": 512,
    "wavelet": "db2",
    "wavelet_levels": 4,
    "edge_keep_quantile": 0.75,
    "block_size": 64,
    "minimum_eligibility_rate": 0.95,
    "maximum_label_gap": 0.05,
    "workers": 4,
    "sampling_epochs": 4
  },
  "optimization": {
    "loss": "bce_with_logits",
    "optimizer": "adamw",
    "head_learning_rate": 0.001,
    "fusion_learning_rate": 0.0003,
    "backbone_learning_rate": 0.00001,
    "weight_decay": 0.0001,
    "effective_batch_size": 32,
    "warmup_fraction": 0.05,
    "gradient_clip_norm": 1.0,
    "max_head_epochs": 20,
    "early_stopping_patience": 3
  },
  "evaluation": {
    "clean_weight": 0.5,
    "robustness_weight": 0.5,
    "threshold": 0.5,
    "bootstrap_iterations": 1000,
    "max_per_class_accuracy_regression": 0.01,
    "calibration": "temperature_scaling_clean_selection_val",
    "final_test_locked": true
  }
}
